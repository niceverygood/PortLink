# PortLink — environment variables example
# 로컬 개발 시 이 파일을 복사: cp .env.example .env

# --- Database ---
# 로컬 docker-compose 기준 (docker compose up -d 후 사용)
# 로컬 호스트의 postgresql과 충돌 회피를 위해 docker가 5433에 매핑됨.
DATABASE_URL="postgresql://portlink:portlink_dev@localhost:5433/portlink?schema=public"

# --- NextAuth (Stage 2에서 본격 사용) ---
NEXTAUTH_URL="http://localhost:3000"
# 운영 시 openssl rand -base64 32 로 생성한 값 사용
NEXTAUTH_SECRET="change-me-to-random-32-byte-base64"

# --- App ---
NODE_ENV="development"
TZ="Asia/Seoul"
