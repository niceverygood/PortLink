# PortLink — environment variables example
# 로컬 개발 시 이 파일을 복사: cp .env.example .env
# 운영(Vercel)에서는 대시보드에 환경변수 등록 — .env.production은 commit 안 함.

# ───────────────────────────────────────────────────
# Database
# ───────────────────────────────────────────────────
# 로컬: docker-compose Postgres (호스트 5433 → 컨테이너 5432)
# 운영: Supabase Postgres connection string
#       postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
#       (Connection Pooling Mode: Session 또는 Transaction)
DATABASE_URL="postgresql://portlink:portlink_dev@localhost:5433/portlink?schema=public"

# Direct connection (마이그레이션 전용 — Supabase는 pooler가 prepared statement 미지원)
# 로컬에선 DATABASE_URL과 동일. 운영에선 Supabase의 "Direct" connection.
DIRECT_URL="postgresql://portlink:portlink_dev@localhost:5433/portlink?schema=public"

# ───────────────────────────────────────────────────
# Auth.js v5
# ───────────────────────────────────────────────────
# AUTH_SECRET은 반드시 `openssl rand -base64 32` 로 생성한 값을 .env에 저장.
# 절대 커밋하지 말 것 (.env는 .gitignore에 포함됨).
AUTH_SECRET="change-me-with-openssl-rand-base64-32"

# 로컬: http://localhost:3000
# 운영: https://portlink.kr
AUTH_URL="http://localhost:3000"

# ───────────────────────────────────────────────────
# 시드 비밀번호 (개발/시연 환경 한정)
# ───────────────────────────────────────────────────
# 이메일 사용자(관리자/포워더/운송사) 시드 계정의 초기 비밀번호.
# 차주는 OTP 로그인이라 무관.
# 운영 환경에서는 빈 문자열로 두고 시드 자체를 실행하지 말 것.
SEED_PASSWORD="portlink2026!"

# ───────────────────────────────────────────────────
# 앱 메타
# ───────────────────────────────────────────────────
# 클라이언트에서도 접근 가능 (Sentry/링크 등에 사용).
# 로컬: http://localhost:3000
# 운영: https://portlink.kr
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="development"
TZ="Asia/Seoul"

# ───────────────────────────────────────────────────
# Sentry (Stage 7부터 사용)
# ───────────────────────────────────────────────────
# 서버용 DSN — sentry.server.config.ts / sentry.edge.config.ts에서 사용
SENTRY_DSN=""
# 클라이언트용 DSN — sentry.client.config.ts에서 사용 (브라우저 노출 OK)
NEXT_PUBLIC_SENTRY_DSN=""
# Sentry 조직/프로젝트 (source map 업로드용 — 빌드 시 사용)
SENTRY_ORG=""
SENTRY_PROJECT=""
# Sentry source map 업로드 토큰 (Vercel 빌드 환경변수로 등록, 로컬은 비워둠)
SENTRY_AUTH_TOKEN=""
